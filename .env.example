# URL de l'API FastAPI ou d'un webhook externe.
# Lancement hors conteneur : http://127.0.0.1:8000/metrics
# Avec docker compose, cette valeur est remplacée par http://api:8000/metrics
# (voir docker-compose.yml) : 127.0.0.1 désignerait le conteneur de l'agent.
METRICS_ENDPOINT=http://127.0.0.1:8000/metrics

# Intervalle entre deux collectes, en secondes
COLLECTION_INTERVAL=5

# Timeout HTTP en secondes
REQUEST_TIMEOUT=5

# Mot de passe Grafana (docker-compose, supervision). Défaut : admin
# GRAFANA_ADMIN_PASSWORD=admin
