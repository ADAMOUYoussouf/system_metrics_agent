# syntax=docker/dockerfile:1

ARG PYTHON_VERSION=3.12.11

# ---------- Étape 1 : builder (installation des dépendances) ----------
FROM python:${PYTHON_VERSION}-slim-bookworm AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build

# requirements copié avant le code : la couche pip est réutilisée
# tant que les dépendances ne changent pas
COPY requirements-api.txt .
RUN pip install -r requirements-api.txt

# ---------- Étape 2 : image finale ----------
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# Applique les correctifs de sécurité Debian publiés depuis la sortie de l'image
# de base (Trivy signalait des CVE HIGH/CRITICAL corrigeables : openssl, gnutls,
# krb5, pcre2, perl...).
# hadolint ignore=DL3005
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*

# Utilisateur non-root, sans shell ni répertoire personnel
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --no-create-home \
            --shell /usr/sbin/nologin app

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --chown=app:app app/__init__.py app/api.py ./app/

USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"]

# Pas de --reload en production ; écoute sur toutes les interfaces du conteneur
CMD ["uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000"]
